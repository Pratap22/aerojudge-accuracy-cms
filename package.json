{
  "name": "npha-accuracy-cms",
  "version": "1.0.0",
  "private": true,
  "description": "AeroJudge by Nepalabs – Professional competition management platform for air sports (Paragliding Accuracy)",
  "author": "Nepalabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pratap22/aerojudge-accuracy-cms.git"
  },
  "homepage": "https://github.com/Pratap22/aerojudge-accuracy-cms#readme",
  "bugs": {
    "url": "https://github.com/Pratap22/aerojudge-accuracy-cms/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "server",
    "database",
    "e2e"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@npha/e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate --workspace=@npha/database",
    "db:migrate": "npm run migrate --workspace=@npha/database",
    "db:seed": "npm run seed --workspace=@npha/database",
    "db:reset": "npm run reset --workspace=@npha/database",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:deploy:pull": "docker compose -f docker/docker-compose.deploy.yml --env-file docker/.env.deploy pull",
    "docker:deploy:up": "docker compose -f docker/docker-compose.deploy.yml --env-file docker/.env.deploy up -d",
    "docker:deploy:down": "docker compose -f docker/docker-compose.deploy.yml --env-file docker/.env.deploy down",
    "docker:deploy:logs": "docker compose -f docker/docker-compose.deploy.yml --env-file docker/.env.deploy logs -f",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "prettier": "^3.2.5",
    "turbo": "^1.13.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.5.0"
}
