# Server – copy values from repo root .env or set locally
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (same as root)
DATABASE_URL=postgresql://npha:npha_secure_password@localhost:5432/npha_accuracy?schema=public

# JWT (same as root)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# CORS (same as root)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Uploads & print archive (same as root)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
PRINT_ARCHIVE_DIR=./uploads/documents/prints
PUBLIC_RESULTS_URL=http://localhost:3003

# Cloudinary (official/judge photo uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=aerojudge

# Rate limiting (same as root)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=15000
