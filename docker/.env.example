# Docker environment – copy to repo root as .env or pass via docker compose --env-file
# Used by: docker compose -f docker/docker-compose.yml --env-file docker/.env up

POSTGRES_USER=npha
POSTGRES_PASSWORD=npha_secure_password
POSTGRES_DB=npha_accuracy
POSTGRES_PORT=5432

REDIS_PORT=6379

HTTP_PORT=80
HTTPS_PORT=443

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!

CORS_ORIGINS=http://localhost,http://localhost/admin,http://localhost/judge,http://localhost/display,http://localhost/results,http://localhost/announcer,http://localhost/overlay

PUBLIC_RESULTS_URL=http://localhost/results

RUN_SEED=true
SEED_ADMIN_EMAIL=admin@npha.org.np
SEED_ADMIN_PASSWORD=NphaAdmin@2024!

MAX_FILE_SIZE_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
