# Copy to docker/.env.deploy on the EC2 host (never commit real secrets).
# CI updates IMAGE_TAG on each deploy; other values stay on the server.

# --- Images (GHCR) ---
# Must match GitHub owner/repo in lowercase. Example:
IMAGE_REGISTRY=ghcr.io/pratap22/aerojudge-accuracy-cms
IMAGE_TAG=latest

# --- HTTP ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Database (not published outside Docker network) ---
POSTGRES_USER=aerojudge
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=aerojudge

# --- Auth (generate long random strings, ≥32 chars) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# --- Public URLs (Elastic IP or domain; no trailing slash on host) ---
# Replace EVERY occurrence of YOUR_HOST with http://EIP or https://your.domain
CORS_ORIGINS=http://YOUR_HOST,http://YOUR_HOST/admin,http://YOUR_HOST/judge,http://YOUR_HOST/display,http://YOUR_HOST/events
PUBLIC_RESULTS_URL=http://YOUR_HOST/events
PUBLIC_API_URL=http://YOUR_HOST
API_URL=http://YOUR_HOST

# --- Seed (true only on first boot; then set false and redeploy) ---
RUN_SEED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeStrongPassword!

MAX_FILE_SIZE_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=15000

# Cloudinary (official/judge photos)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=aerojudge

# AWS SES (password reset). Required in production for forgot-password emails.
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=noreply@your-verified-domain.com
# SES_FROM_NAME=AeroJudge
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
