# Application
NODE_ENV=development
APP_NAME=AeroJudge
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://npha:npha_secure_password@localhost:5432/npha_accuracy?schema=public
POSTGRES_USER=npha
POSTGRES_PASSWORD=npha_secure_password
POSTGRES_DB=npha_accuracy
POSTGRES_PORT=5432

# Redis (optional – for rate limiting / offline sync queue)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Marketing site (optional build-time overrides for apps/marketing)
# VITE_SITE_URL=https://aerojudge.nepalabs.com
# VITE_CONTACT_EMAIL=hello@nepalabs.com

# Optional: override sibling staff app URLs used after login redirects (Admin ↔ Judge)
# VITE_ADMIN_URL=http://localhost:3000/
# VITE_JUDGE_URL=http://localhost:3001/

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
# Absolute origin for /uploads assets (logos). Used when storing/returning logoUrl.
PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000

# Cloudinary (official/judge photo uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=aerojudge

# AWS SES (password reset emails). Leave SES_FROM_EMAIL unset to log emails in dev.
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=noreply@example.com
# SES_FROM_NAME=AeroJudge
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=15000

# Seed defaults
SEED_ADMIN_EMAIL=admin@npha.org.np
SEED_ADMIN_PASSWORD=NphaAdmin@2024!
SEED_COMPETITION_CODE=NPHA-ACC-2024

# Optional: auto-open a competition on venue/public apps (id or publicSlug). Prefer picking from the home list.
# VITE_COMPETITION_SLUG=
# VITE_DEFAULT_SLUG=

# Print archive
PRINT_ARCHIVE_DIR=./uploads/documents/prints
